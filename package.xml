<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>audio_io</name>
  <version>0.1.0</version>
  <description>ALSA playback/capture node and reusable audio engine library</description>
  <maintainer email="mdmbct@163.com">greenhand520</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>audio_io_interface</depend>
  <depend>common_cpp</depend>

  <build_depend>libasound2-dev</build_depend>
  <exec_depend>libasound2-dev</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
